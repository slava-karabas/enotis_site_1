Options -Indexes
DirectoryIndex index.php

RewriteEngine On
# Существующие файлы (css, js, фото) отдаются как есть.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# Всё остальное — в роутер.
RewriteRule ^ index.php [L,QSA]

# Только статические файлы: личные страницы и API остаются без публичного кэша.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2?|ttf|png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>
  <FilesMatch "^[0-9]+-[0-9a-f]{8}-h?[lms]\.jpg$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript text/javascript image/svg+xml
</IfModule>
